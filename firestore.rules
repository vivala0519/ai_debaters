rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // History is accessible only through the UID-verified server API.
    // Firebase Admin uses IAM and does not rely on these browser access rules.
    match /prismHistory/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
