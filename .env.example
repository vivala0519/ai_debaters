# Optional server fallback. Users can enter their own keys on the settings page.
# AI provider keys are server secrets: never use NEXT_PUBLIC_ for these keys.
# Never commit .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides. Per-user settings take precedence.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.8-flash

# ChatGPT OAuth sign-in is supported on local HTTP loopback.
# No OAuth client secret or existing Codex credentials are needed.
# Optional protected local runtime directory; defaults to .agora/ (gitignored).
# AGORA_CHATGPT_AUTH_DIR=

# Optional absolute path to the official Antigravity CLI binary (agy.exe on Windows).
# Otherwise it is discovered on the Next.js server's PATH. Restart dev after installing.
# Sign in with your Google account using agy in a terminal. Local-only; not Vercel.
# AGORA_ANTIGRAVITY_PATH=C:\path\to\agy.exe
# Firebase browser configuration: set actual values in ignored .env.local and Vercel.
# NEXT_PUBLIC_ values are visible in the browser; never put service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Site login uses Firebase Authentication.
# Enable Google and add the deployed hostname to Firebase's Authorized domains.
# Login alone needs no Google client secret, AUTH_SECRET or service-account key.
# Optional canonical HTTPS origin for custom reverse proxies; Vercel detects its host automatically.
# Leave empty for localhost and Vercel. See docs/google-login.md.
AUTH_URL=

# Optional cross-device debate history (server-only). See docs/history-sync.md.
# Use the SAME project as NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# PEM private key; literal \n escapes are accepted. Never use NEXT_PUBLIC_ here.
FIREBASE_ADMIN_PRIVATE_KEY=
# For trusted Google runtimes or local ADC instead of a service-account key:
FIREBASE_ADMIN_USE_APPLICATION_DEFAULT=false

# Local-only history sync through your trusted HTTPS deployment, without admin keys.
# Used only on localhost when no FIREBASE_ADMIN_* settings are present; never on Vercel.
# PRISM_HISTORY_SYNC_ORIGIN=https://your-project.vercel.app

# Optional account API-key sync. Requires the Firebase Admin settings above.
# 32 random bytes as base64/base64url or 64 hex characters. Server-only; keep stable.
# Existing PRISM_CONNECTIONS_ENCRYPTION_KEY is also accepted if already configured.
# See docs/api-key-sync.md. Never use NEXT_PUBLIC_ for the encryption key.
PRISM_API_KEYS_ENCRYPTION_KEY=
