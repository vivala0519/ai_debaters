# Optional server fallback. Users can enter their own keys on the settings page.
# Do not use NEXT_PUBLIC_ for API keys. Never commit .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides. Per-user settings take precedence.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.8-flash

# ChatGPT plan OAuth is supported only on local HTTP loopback, not Vercel.
# No OAuth client secret or existing Codex credentials are needed.
# Optional protected local runtime directory; defaults to .agora/ (gitignored).
# AGORA_CHATGPT_AUTH_DIR=

# Optional absolute path to the official Antigravity CLI binary (agy.exe on Windows).
# Otherwise it is discovered on the Next.js server's PATH. Restart dev after installing.
# Sign in with your Google account using agy in a terminal. Local-only; not Vercel.
# AGORA_ANTIGRAVITY_PATH=C:\path\to\agy.exe
